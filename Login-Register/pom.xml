<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  
  <!-- Project Properties for Multi-Module Setup -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>VirtualBookstore</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging> <!-- Multi-module pom -->

  
  <!-- Repository Configuration -->
  <repositories>
    <repository>
      <id>nexus</id>
      <name>Nexus Release Repository</name>
      <url>https://repo.maven.apache.org/maven2/</url>
    </repository>
    
    <repository>
      <id>npm-registry</id>
      <url>https://registry.npmjs.org/</url>
    </repository>
  </repositories>

  
  <!-- Maven Plugins -->
  <build>
    <plugins>
      <!-- NPM Maven Plugin Configuration for running frontend scripts -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        
        <!-- Frontend Development Script as Maven Goal -->
        <executions>
          <execution>
            <id>run-frontend-dev</id>
            <phase>compile</phase>
            <configuration>
              <target>
                <!-- Change to frontend directory and run npm dev -->
                <property name="frontend.dir" value="${project.basedir}/Login-Register/login-register"/>
                <exec dir="${frontend.dir}">
                  <command>node_modules\.bin\npm.cmd install</command>
                  <env key="NODE_ENV">development</env>
                </exec>
                
                <!-- Start the Vite dev server as a background process -->
                <exec dir="${frontend.dir}" taskname="npm-run-dev">
                  <command>node_modules\.bin\npm.cmd run dev</command>
                  <arg line="--port 5173 --host localhost" />
                </exec>
              </target>
            </configuration>
          </execution>
          
          <!-- Build Frontend -->
          <execution>
            <id>build-frontend</id>
            <phase>package</phase>
            <configuration>
              <target>
                <property name="frontend.dir" 
                          value="${project.basedir}/Login-Register/login-register"/>
                <exec dir="${frontend.dir}">
                  <command>npm.cmd run build</command>
                </exec>
              </target>
            </configuration>
          </execution>
          
          <!-- Install NPM Dependencies -->
          <execution>
            <id>install-npm-dependencies</id>
            <phase>process-resources</phase>
            <configuration>
              <target>
                <property name="frontend.dir" 
                          value="${project.basedir}/Login-Register/login-register"/>
                <exec dir="${frontend.dir}">
                  <command>npm.cmd install</command>
                </exec>
              </target>
            </configuration>
          </execution>
          
        </executions>
      </plugin>
      
      <!-- Maven Compiler Plugin for Java -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <source>21</source>
          <target>21</target>
        </configuration>
      </plugin>
      
      <!-- Spring Boot Maven Plugin -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>3.2.5</version>
        <!-- Exclude frontend module from Spring Boot build -->
        <excludes>
          <exclude>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-metadata</artifactId>
          </exclude>
        </excludes>
      </plugin>
    </plugins>
  </build>

  
  <!-- Module definitions for multi-module project -->
  <modules>
    <module>Login-Register/src/main/java/com/example/VirtualBookstore</module>
    <module>Login-Register/login-register</module>
  </modules>
</project>
